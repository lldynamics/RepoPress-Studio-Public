{
  "manifest_version": 3,
  "name": "个人网站发布控制台 · 资料采集",
  "description": "把当前网页完整归档并保存到本机资料库分类。",
  "version": "0.12.0",
  "key": "",
  "minimum_chrome_version": "109",
  "action": {
    "default_title": "保存到资料库",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "nativeMessaging",
    "pageCapture",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "打开资料采集面板"
    },
    "quick-save-cleaned": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "快速保存当前网页净化正文"
    },
    "quick-save-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "快速保存当前选中文字"
    }
  }
}
