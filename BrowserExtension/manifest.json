{
  "manifest_version": 3,
  "name": "个人网站发布控制台 · 资料采集",
  "description": "把当前网页完整归档并保存到本机资料库分类。",
  "version": "0.2.0",
  "minimum_chrome_version": "109",
  "action": {
    "default_title": "保存到资料库",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "pageCapture",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:47831/*"
  ]
}
