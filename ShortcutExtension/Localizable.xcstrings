    "将 HTTPS 网页放入 RepoPress 资料库的待导入收件箱。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an HTTPS webpage to the RepoPress library import inbox."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 HTTPS 网页放入 RepoPress 资料库的待导入收件箱。"
          }
        }
      }
    },
    "将受支持的文档或图片放入 RepoPress 资料库的待导入收件箱。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a supported document or image to the RepoPress library import inbox."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将受支持的文档或图片放入 RepoPress 资料库的待导入收件箱。"
          }
        }
      }
    },
    "将文本作为资料库原生笔记放入 RepoPress 的待导入收件箱。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add text to the RepoPress import inbox as a native library note."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文本作为资料库原生笔记放入 RepoPress 的待导入收件箱。"
          }
        }
      }
    },
