    "紫罗兰 Violet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Violet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫罗兰 Violet"
          }
        }
      }
    },
    "自定义 RepoPress Studio 的主题强调色，并决定选择态如何跟随 macOS。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize the RepoPress Studio theme accent and how selection states follow macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义 RepoPress Studio 的主题强调色，并决定选择态如何跟随 macOS。"
          }
        }
      }
    },
    "薄荷绿 Emerald": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emerald"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "薄荷绿 Emerald"
          }
        }
      }
    },
    "默认跟随 macOS，也可以选择一个专属颜色。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow macOS by default, or choose a personal accent color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认跟随 macOS，也可以选择一个专属颜色。"
