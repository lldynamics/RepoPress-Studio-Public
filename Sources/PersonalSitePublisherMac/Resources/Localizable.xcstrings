    "平台部署 Token 只发送到平台官方 API；如需向状态端点发送 Bearer Token，请选择“自定义端点”平台并使用 HTTPS。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Platform deployment tokens are sent only to official platform APIs. To send a Bearer token to a status endpoint, choose the Custom Endpoint platform and use HTTPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平台部署 Token 只发送到平台官方 API；如需向状态端点发送 Bearer Token，请选择“自定义端点”平台并使用 HTTPS。"
          }
        }
      }
    },
    "平台部署访问令牌只发送到平台官方 API；如需向状态端点发送 Bearer Token，请选择“自定义端点”平台并使用 HTTPS。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider deployment access tokens are sent only to the provider's official API. To send a bearer token to a status endpoint, choose the Custom Endpoint provider and use HTTPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平台部署访问令牌只发送到平台官方 API；如需向状态端点发送 Bearer Token，请选择“自定义端点”平台并使用 HTTPS。"
          }
        }
      }
    },
    "应用 AI 回复到文章": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply AI Response to Article"
          }
        },
        "zh-Hans": {
