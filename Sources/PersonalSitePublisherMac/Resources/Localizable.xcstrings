{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "主题强调色": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme Accent Color"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题强调色"
          }
        }
      }
    },
    "外观": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "此颜色会立即应用到所有工作台窗口，并在下次启动时保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This color applies immediately to every workspace window and is preserved the next time the app starts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此颜色会立即应用到所有工作台窗口，并在下次启动时保留。"
          }
        }
      }
    },
    "玫瑰红 Rose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rose"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玫瑰红 Rose"
          }
        }
      }
    },
    "琥珀黄 Amber": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amber"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "琥珀黄 Amber"
          }
        }
