{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:deny-check",
    "updater:deny-download",
    "updater:deny-install",
    "updater:deny-download-and-install"
  ]
}
