{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoPress Studio",
  "version": "0.1.0",
  "identifier": "com.repopress.studio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RepoPress Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; frame-src http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "publisher": "RepoPress contributors",
    "copyright": "Copyright © 2026 RepoPress contributors",
    "category": "Productivity",
    "shortDescription": "安全、专注的 Markdown 仓库写作工作台",
    "longDescription": "RepoPress Studio 是面向本地 Git 仓库的 Markdown 写作工作台，提供安全预览、冲突检测和原子保存。",
    "homepage": "https://github.com/lldynamics/RepoPress-Studio-Public",
    "license": "MPL-2.0",
    "licenseFile": "../../../LICENSE",
    "linux": {
      "deb": {
        "section": "editors",
        "recommends": [
          "git",
          "libsecret-tools",
          "bubblewrap",
          "poppler-utils",
          "tesseract-ocr",
          "tesseract-ocr-eng",
          "tesseract-ocr-chi-sim"
        ],
        "files": {
          "/usr/share/doc/repo-press-studio/copyright": "../../../LICENSE"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/doc/repo-press-studio/LICENSE": "../../../LICENSE"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
