# App Store Archive Validation Environment

# Copy this file outside the repository before filling values. Keep account
# emails, signing team values, validation receipts, local archive paths, and
# account-specific notes out of git. This template records only redacted
# summaries after the external App Store archive and Transporter/App Store
# Connect validation has actually been performed.

# Redacted evidence summaries required by:
# script/record_app_store_archive_validation_bundle.sh --execute
APP_STORE_ARCHIVE_CLEAN_RELEASE_SUMMARY=""
APP_STORE_ARCHIVE_SIGNING_RUNTIME_SUMMARY=""
APP_STORE_ARCHIVE_TRANSPORTER_SUMMARY=""

# Optional evidence output override. Leave empty to update:
# docs/release-evidence/APP_STORE_ARCHIVE_VALIDATION.md
APP_STORE_ARCHIVE_EVIDENCE_FILE=""

# Suggested private run sequence after filling the copied file:
# script/check_external_verification_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --mode filled --target app-store-archive --report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md
# script/run_external_verification_from_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --target app-store-archive --env-status-report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md
# script/run_external_verification_from_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --target app-store-archive --env-status-report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md --execute
# script/sync_app_store_checklist.sh --execute
# ./script/check_release_gate.sh --strict
