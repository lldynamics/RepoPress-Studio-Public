# Remote Conflict, Deployment, And Rollback Evidence Environment

# Copy this file outside the repository before filling values. Keep
# provider-specific identifiers, account details, local paths, tokens, private
# content excerpts, screenshots with personal data, and provider-specific notes
# out of git. This template records only redacted summaries after a disposable
# remote-publish recovery run has actually been performed.

# Redacted evidence summaries required by:
# script/record_remote_recovery_evidence.sh --execute
REMOTE_RECOVERY_CONFLICT_PREVIEW_SUMMARY=""
REMOTE_RECOVERY_PENDING_OFFLINE_SUMMARY=""
REMOTE_RECOVERY_DEPLOYMENT_RETRY_SUMMARY=""
REMOTE_RECOVERY_ROLLBACK_PACKAGE_SUMMARY=""

# Optional HTTPS evidence URL and evidence output override. Leave the output
# path empty to update docs/release-evidence/EXTERNAL_VERIFICATION_EVIDENCE.md.
REMOTE_RECOVERY_EVIDENCE_URL=""
EXTERNAL_VERIFY_EVIDENCE_FILE=""

# Suggested private run sequence after filling the copied file:
# script/check_external_verification_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --mode filled --target remote-recovery --report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md
# script/run_external_verification_from_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --target remote-recovery --env-status-report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md
# script/run_external_verification_from_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --target remote-recovery --env-status-report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md --execute
# script/sync_app_store_checklist.sh --execute
# ./script/check_release_gate.sh --strict
