# StoreKit Sandbox Evidence Environment

# Copy this file outside the repository before filling values. Keep sandbox
# account emails, purchase numbers, receipts, screenshots with personal data,
# and account-specific notes out of git. This template records only redacted
# summaries after the sandbox purchase, restore, free quota, and boundary event
# checks have actually been performed.

# The local StoreKit product ID is checked automatically by
# script/record_storekit_sandbox_evidence.sh. Override only if a future product
# ID has been intentionally introduced and the StoreKit config has been updated.
STOREKIT_PRODUCT_ID="personal.site.publisher.pro"

# Redacted evidence summaries required by:
# script/record_storekit_sandbox_evidence.sh --execute
STOREKIT_SANDBOX_PRODUCT_LOOKUP_SUMMARY=""
STOREKIT_SANDBOX_PURCHASE_SUMMARY=""
STOREKIT_SANDBOX_RESTORE_SUMMARY=""
STOREKIT_SANDBOX_FREE_QUOTA_SUMMARY=""
STOREKIT_SANDBOX_BOUNDARY_EVENTS_SUMMARY=""

# Optional HTTPS evidence URL and evidence output override. Leave the output
# path empty to update docs/release-evidence/EXTERNAL_VERIFICATION_EVIDENCE.md.
STOREKIT_SANDBOX_EVIDENCE_URL=""
EXTERNAL_VERIFY_EVIDENCE_FILE=""

# Suggested private run sequence after filling the copied file:
# script/check_external_verification_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --mode filled --target storekit --report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md
# script/run_external_verification_from_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --target storekit --env-status-report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md
# script/run_external_verification_from_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --target storekit --env-status-report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md --execute
# script/sync_app_store_checklist.sh --execute
# ./script/check_release_gate.sh --strict
