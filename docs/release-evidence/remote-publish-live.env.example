# Remote Publish Live Verification Environment

# Copy this file outside the repository before filling values. Keep real tokens,
# account identifiers, disposable repository names, and private notes out of git.
# Run script/verify_remote_publish_live_matrix.sh without --execute first to
# confirm the planned GitHub/GitLab direct and review verification commands.

# Shared optional settings.
REMOTE_VERIFY_BRANCH="main"
# Optional operator note. The verifier also records provider API permission
# evidence such as GitHub permissions.push or GitLab access_level.
REMOTE_VERIFY_TOKEN_SCOPE_SUMMARY="Least-privilege disposable repository token was used for this live verification."

# Keep defaults unless the disposable repository intentionally needs custom paths
# or branch names.
REMOTE_VERIFY_ALLOW_CUSTOM_PATH="0"
REMOTE_VERIFY_ALLOW_CUSTOM_BRANCH="0"

# Optional review cleanup. Leave at 0 to keep generated PR/MR and review
# branches available for manual inspection. Set to 1 only for disposable review
# runs where the verifier should close the PR/MR and delete the temporary review
# branch after deployment status has been checked and before writing evidence.
REMOTE_VERIFY_REVIEW_CLEANUP="0"

# GitHub disposable test repository.
# Required with --execute:
REMOTE_VERIFY_GITHUB_TOKEN=""
REMOTE_VERIFY_GITHUB_OWNER=""
REMOTE_VERIFY_GITHUB_REPO=""
# Must summarize the GitHub direct commit release ledger entry.
REMOTE_VERIFY_GITHUB_DIRECT_RELEASE_LEDGER=""
# Must summarize the GitHub PR/review branch release ledger entry.
REMOTE_VERIFY_GITHUB_REVIEW_RELEASE_LEDGER=""

# Optional GitHub Enterprise API base URL and per-mode overrides.
REMOTE_VERIFY_GITHUB_BASE_URL=""
REMOTE_VERIFY_GITHUB_DIRECT_PATH=""
REMOTE_VERIFY_GITHUB_REVIEW_PATH=""
REMOTE_VERIFY_GITHUB_REVIEW_BRANCH_NAME=""

# GitLab disposable test project.
# Required with --execute:
REMOTE_VERIFY_GITLAB_TOKEN=""
REMOTE_VERIFY_GITLAB_OWNER=""
REMOTE_VERIFY_GITLAB_REPO=""
# Must summarize the GitLab direct commit release ledger entry.
REMOTE_VERIFY_GITLAB_DIRECT_RELEASE_LEDGER=""
# Must summarize the GitLab MR/review branch release ledger entry.
REMOTE_VERIFY_GITLAB_REVIEW_RELEASE_LEDGER=""

# Optional self-hosted GitLab web base URL and per-mode overrides.
REMOTE_VERIFY_GITLAB_BASE_URL=""
REMOTE_VERIFY_GITLAB_DIRECT_PATH=""
REMOTE_VERIFY_GITLAB_REVIEW_PATH=""
REMOTE_VERIFY_GITLAB_REVIEW_BRANCH_NAME=""

# Optional evidence output override. Leave empty to update:
# docs/release-evidence/EXTERNAL_VERIFICATION_EVIDENCE.md
REMOTE_VERIFY_EVIDENCE_FILE=""

# Suggested private run sequence after filling the copied file:
# script/check_external_verification_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --mode filled --target remote-publish --report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md
# script/run_external_verification_from_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --target remote-publish --env-status-report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md
# script/run_external_verification_from_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --target remote-publish --env-status-report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md --execute
# script/sync_app_store_checklist.sh --execute
# ./script/check_release_gate.sh --profile app-store
