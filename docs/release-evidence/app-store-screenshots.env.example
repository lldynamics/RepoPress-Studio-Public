# App Store Screenshot Evidence Environment
#
# Copy this file outside the repository with:
#
#   script/prepare_external_verification_envs.sh --output-dir /private/tmp/personal-site-publisher-release-envs --target app-store-screenshots
#
# Fill only the copied file. Do not paste private article text, local account
# paths, tokens, or personal account identifiers here.

# Redacted summaries used when recording app-store-screenshots external evidence.
APP_STORE_SCREENSHOT_SET_SUMMARY="TODO: Ten App Store screenshots were captured for writing, AI chat, sync/API publish, SEO/social preview, deployment, maintenance, general drafts, Pro, privacy lock, and release readiness."
APP_STORE_SCREENSHOT_PRIVACY_GATE_SUMMARY="TODO: Screenshot privacy gate passed with no local paths, tokens, or private article text."
APP_STORE_SCREENSHOT_STRICT_GATE_SUMMARY="TODO: STRICT_SCREENSHOTS=1 check_screenshots.sh and screenshot manifest sync passed."

# Optional overrides. Leave empty to use docs/app-store-screenshots and its manifest.
APP_STORE_SCREENSHOT_DIR=""
APP_STORE_SCREENSHOT_MANIFEST_FILE=""

# Suggested private run sequence after filling the copied file:
# script/check_external_verification_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --mode filled --target app-store-screenshots --report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md
# script/run_external_verification_from_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --target app-store-screenshots --env-status-report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md
# script/run_external_verification_from_envs.sh --env-dir /private/tmp/personal-site-publisher-release-envs --target app-store-screenshots --env-status-report-file /private/tmp/personal-site-publisher-release-envs/ENV_STATUS.md --execute
# script/sync_app_store_checklist.sh --execute
# ./script/check_release_gate.sh --strict
