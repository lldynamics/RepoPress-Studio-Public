{
  "$defs": {
    "fixture-metadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "title": "Fixture metadata",
      "type": "object"
    }
  },
  "$id": "urn:repopress:contracts:v1:fixture-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned registry and byte digests for golden contract cases.",
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/fixture-metadata"
      },
      "type": "array"
    },
    "formatVersion": {
      "const": 1
    },
    "minimumReaderVersion": {
      "const": 1
    }
  },
  "required": [
    "formatVersion",
    "minimumReaderVersion",
    "cases"
  ],
  "title": "RepoPress M1 fixture manifest",
  "type": "object"
}
