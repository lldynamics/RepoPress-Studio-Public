  "display.ai-publishing-chat-quick-action.english-summary": {
    "en": "English Summary",
    "zh-Hans": "英文摘要"
  },
  "display.ai-publishing-chat-quick-action.english-summary.compact": {
    "en": "English",
    "zh-Hans": "英文"
  },
  "display.ai-publishing-chat-quick-action.english-summary.prompt": {
    "en": "Generate a natural English title and summary for the current article. Use the fields TITLE: and SUMMARY:. Keep the summary between 25 and 45 English words, preserve proper nouns, stay faithful to the source, and add no new facts. Do not translate the full article or add explanations.",
    "zh-Hans": "请基于当前文章生成自然英文标题和英文摘要。使用 TITLE: 和 SUMMARY: 两个字段；摘要控制在 25 到 45 个英文单词，保留专有名词，忠实原文，不新增事实。不要翻译整篇正文，不要添加解释。"
  },
  "display.ai-publishing-chat-quick-action.polish-suggestions": {
    "en": "Polish Suggestions",
    "zh-Hans": "润色建议"
  },
  "display.ai-publishing-chat-quick-action.polish-suggestions.compact": {
    "en": "Polish",
    "zh-Hans": "润色"
  },
  "display.ai-publishing-chat-quick-action.polish-suggestions.prompt": {
    "en": "Proofread the current article and provide up to five polishing suggestions. Format each as “Original / Suggested Revision / Reason.” Quote only the necessary short excerpt. Do not rewrite the full article or change facts, code, links, or Front Matter. If there are no clear issues, say so directly.",
    "zh-Hans": "请校对当前文章并给出最多 5 条润色建议。每条按“原文片段 / 建议改写 / 原因”输出；只引用必要短句，不要重写整篇文章，不要改变事实、代码、链接或 Front Matter。没有明显问题时直接说明。"
  },
  "display.ai-publishing-chat-quick-action.proofread": {
    "en": "Proofread Post",
    "zh-Hans": "校对文章"
  },
  "display.ai-publishing-chat-quick-action.proofread.compact": {
    "en": "Proofread",
    "zh-Hans": "校对"
  },
  "display.ai-publishing-chat-quick-action.proofread.prompt": {
    "en": "Proofread the current article for typos, punctuation errors, and unclear sentences. List only definite issues in a three-column table: “Original / Suggestion / Reason.” Do not rewrite paragraphs without problems. If there are no clear issues, reply: “No obvious writing issues found.”",
    "zh-Hans": "请校对当前文章中的错别字、标点误用和病句。只列出明确发现的问题，按“原文 / 建议 / 原因”三列表格输出，不要重写没有问题的段落；若无明显问题，直接回复“未发现明显的文字问题”。"
  },
  "display.ai-publishing-chat-quick-action.summary": {
    "en": "Generate Summary",
    "zh-Hans": "生成摘要"
  },
  "display.ai-publishing-chat-quick-action.summary.compact": {
    "en": "Summary",
    "zh-Hans": "摘要"
  },
  "display.ai-publishing-chat-quick-action.summary.prompt": {
    "en": "Create a summary or description that can be written directly to the current article’s Front Matter. Use 60–160 Chinese characters for Chinese articles or 25–45 English words for English articles. Stay faithful to the source, remain concise, and add no new facts. If the body contains only a title, placeholder, writing guidance, or too little content to identify the topic, return only: “There is not enough content to generate a useful summary. Add article content and try again.” Otherwise return only the summary text, without a title, numbering, quotation marks, explanation, analysis, or reasoning.",
    "zh-Hans": "请基于当前文章生成一条可直接写入 Front Matter 的 summary/description，控制在 60 到 160 个中文字符；英文文章控制在 25 到 45 个英文单词。忠实原文、保持克制、不新增事实。如果正文只有标题、占位语、写作引导或无法判断主题，只返回“当前内容不足，无法生成有效摘要，请补充正文后重试。”不要为占位内容强行生成摘要。其他情况下只返回摘要正文，不要标题、编号、引号、解释、分析或推理过程。"
  },
  "display.ai-publishing-chat-quick-action.tag-suggestions": {
    "en": "Tag Suggestions",
    "zh-Hans": "标签建议"
  },
  "display.ai-publishing-chat-quick-action.tag-suggestions.compact": {
    "en": "Tags",
    "zh-Hans": "标签"
  },
  "display.ai-publishing-chat-quick-action.tag-suggestions.prompt": {
    "en": "Recommend 3–8 stable, reusable tags based on the current article. Return one comma-separated line only, with no numbering, quotation marks, Markdown, categories, or extra explanation. Do not invent topics the article does not cover.",
    "zh-Hans": "请基于当前文章推荐 3 到 8 个稳定、可复用的 tags。只返回一行逗号分隔的标签，不要编号、引号、Markdown、分类或额外解释，不要编造文章没有涉及的主题。"
  },
