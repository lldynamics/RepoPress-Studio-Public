{
  "schemaVersion": 2,
  "description": "Profile-aware release-gate manifest. Commands use argv, never shell strings.",
  "defaultTimeoutSeconds": 1800,
  "profiles": {
    "common": [
      "repository-source-boundary",
      "repository-source-boundary-tests",
      "privacy-copy",
      "privacy-copy-tests",
      "typography",
      "typography-tests",
      "release-runner-contract-tests",
      "ci-quality",
      "swift-format-lint",
      "swift-format-lint-tests",
      "swift-safety",
      "swift-safety-tests",
      "swift-coverage",
      "swift-coverage-tests",
      "swift-strict-build",
      "swift-strict-build-tests",
      "swift6-migration-tests",
      "swift-release-build",
      "swift-release-build-tests",
      "swift-tests-sharding-tests",
      "swift-tests",
      "repository-release-clean"
    ],
    "direct": [
      "localization",
      "build-version",
      "build-version-tests",
      "browser-extension-release",
      "browser-extension-release-tests",
      "browser-extension-protocol-generation-tests",
      "ui-runtime",
      "ui-launch-verification",
      "accessibility-runtime",
      "direct-release-package-path",
      "direct-release-package-tests",
      "direct-release-notarization-readiness"
    ],
    "chrome": [
      "browser-extension-release",
      "browser-extension-release-tests",
      "browser-extension-protocol-generation-tests",
      "chromium-extension-store-package-tests",
      "chrome-extension-store-readiness"
    ]
  },
  "checks": [
    {"id":"repository-source-boundary","title":"Clean-checkout source boundary","groups":["quick"],"source":["Package.swift","Sources","Tests","Packaging","script"],"evidence":["all build and release inputs tracked by Git"],"strictness":"always","command":["bash","script/check_repository_source_boundary.sh"]},
    {"id":"repository-source-boundary-tests","title":"Clean-checkout source boundary behavior","source":["script/check_repository_source_boundary.sh"],"evidence":["untracked critical input regression"],"strictness":"always","command":["bash","script/test_repository_source_boundary.sh"]},
    {"id":"browser-extension-release","title":"Safari, Chrome, and Firefox authenticated-loopback release chain","source":["package.json","package-lock.json","BrowserExtension/browser-extension-protocol.json","BrowserExtension/chromium-store-listing.json","BrowserExtension/release-ledger.json","BrowserExtension","Packaging/SafariWebExtension.entitlements","Packaging/SafariWebExtension","script/sync_firefox_browser_extension.sh","script/sync_safari_browser_extension.sh","script/build_safari_web_extension.sh","script/browser_extension_release_ledger.py","script/test_browser_extension_release_ledger.py","script/generate_browser_extension_protocol.py","script/chromium_extension_release.py","script/test_browser_extension_compatibility.mjs","script/test_browser_extension_e2e.mjs","Sources/BrowserExtensionProtocolSupport","Sources/PersonalSitePublisherMac/Support/KnowledgeBrowserBridge.swift","Sources/PersonalSitePublisherMac/Support/KnowledgeBrowserImportLedgerStore.swift","Sources/PersonalSitePublisherMac/App/WorkbenchLaunchCoordinator.swift","Sources/PublishingWorkbenchCore/Stores/KnowledgeStore.swift","Tests/PublishingWorkbenchCoreTests/KnowledgeBrowserImportOperationLedgerTests.swift","Tests/PublishingWorkbenchCoreTests/KnowledgeLibraryServiceTests.swift","Tests/PersonalSitePublisherMacTests/BrowserExtensionOriginPolicyTests.swift","Tests/PersonalSitePublisherMacTests/KnowledgeBrowserImportLedgerStoreTests.swift"],"evidence":["single-source active-channel contract for Safari, Chrome, and Firefox","generated Swift/JavaScript loopback protocol contract including Safari bundle identity and Firefox add-on identity","Safari Web Extension source parity and buildable embedded appex","immutable version and Chrome ZIP source/artifact SHA-256 ledger","version downgrade and same-version source/artifact replacement regressions","reproducible minimal Chrome Web Store ZIP","authenticated 127.0.0.1 transport with required protocol header and extension-origin preflight boundary","Safari and Firefox UUID origin boundary","real Chromium and Firefox BiDi E2E","browser-owned optional-permission prompt boundary","MV3 service-worker termination and message wake-up","real keyboard focus and 320px reflow","two-stage exact-origin batch permissions with temporary tabs discovery and redundant cleanup","stable browser import operation IDs and non-overwriting version queue","persistent idempotent receipt replay","move-only duplicate resolution preserves content, metadata, and AI permission","complete App Store application product build"],"strictness":"always","command":["bash","script/check_browser_extension_release.sh"]},
    {"id":"browser-extension-release-tests","title":"Browser extension release gate behavior","source":["script/check_browser_extension_release.sh"],"evidence":["full command coverage and failure propagation regressions"],"strictness":"always","command":["bash","script/test_browser_extension_release_gate.sh"]},
    {"id":"browser-extension-protocol-generation-tests","title":"Browser extension protocol generation behavior","source":["BrowserExtension/browser-extension-protocol.json","script/generate_browser_extension_protocol.py"],"evidence":["stale generated artifact and manifest-ID mismatch regressions","Chromium public-key-derived ID regression"],"strictness":"always","command":["python3","script/test_browser_extension_protocol_generation.py"]},
    {"id":"chromium-extension-store-package-tests","title":"Chrome store package behavior","source":["BrowserExtension/chromium-store-listing.json","BrowserExtension/shared/icons","script/chromium_extension_release.py"],"evidence":["minimal deterministic ZIP payload","development-key exclusion","HTTPS listing metadata","active-channel and production identity regressions"],"strictness":"always","command":["python3","script/test_chromium_extension_release.py"]},
    {"id":"chrome-extension-store-readiness","title":"Chrome Web Store production identity","source":["BrowserExtension/browser-extension-protocol.json","BrowserExtension/chromium-store-listing.json"],"evidence":["store-assigned Chrome extension ID","authenticated loopback host permission"],"strictness":"strict","command":["python3","script/chromium_extension_release.py","readiness","--channel","chrome"]},
    {"id":"localization","title":"Localization coverage","groups":["quick"],"source":["Package.swift","Sources/PersonalSitePublisherMac/Resources"],"evidence":["Localizable.xcstrings","localized strings"],"strictness":"always","command":["bash","script/check_localization_gate.sh"]},
    {"id":"typography","title":"Readable semantic typography","groups":["quick"],"source":["Sources/PersonalSitePublisherMac","script/check_typography.py"],"evidence":["semantic text styles","minimum readable metadata size","non-shrinking workspace navigation","non-mini controls"],"strictness":"always","command":["python3","script/check_typography.py"]},
    {"id":"typography-tests","title":"Typography gate behavior","groups":["quick"],"source":["script/check_typography.py","script/test_typography_gate.py"],"evidence":["caption2, mini-control, navigation scaling, and fixed-point text regressions"],"strictness":"always","command":["python3","script/test_typography_gate.py"]},
    {"id":"build-version","title":"Single-source build version","groups":["quick"],"source":["Packaging/BuildVersion.xcconfig"],"evidence":["validated marketing version and build number"],"strictness":"always","command":["bash","script/check_build_version.sh"]},
    {"id":"build-version-tests","title":"Build version gate behavior","groups":["quick"],"source":["script/check_build_version.sh"],"evidence":["missing, invalid, placeholder, and mismatch regressions"],"strictness":"always","command":["bash","script/test_build_version_gate.sh"]},
    {"id":"direct-release-package-path","title":"Developer ID direct-release workflow availability","source":["Packaging/DirectDistribution.entitlements","Packaging/ThirdPartyNotices/Sparkle-LICENSE.txt","script/build_and_run.sh","script/sign_sparkle_framework.sh","script/generate_direct_appcast.sh","script/package_direct_release.sh"],"evidence":["credential-free dry-run","explicit hardened nested signing","Developer ID signed DMG","notarization and stapling workflow","bundled third-party notices","DMG, ZIP, signed appcast, manifest, and SHA-256 outputs"],"strictness":"always","command":["bash","script/package_direct_release.sh","--dry-run"]},
    {"id":"direct-release-package-tests","title":"Developer ID packaging behavior","source":["script/package_direct_release.sh","script/sign_sparkle_framework.sh","script/generate_direct_appcast.sh","script/test_package_direct_release.sh"],"evidence":["safe output boundary","credential-free prepare mode","Sparkle inside-out signing order","DMG signing and team binding","third-party notice packaging","notarization rejection propagation","stable-channel appcast semantics","artifact and manifest validation"],"strictness":"always","command":["bash","script/test_package_direct_release.sh"]},
    {"id":"direct-release-notarization-readiness","title":"Signed and notarized direct-release artifacts","source":["dist/direct","script/package_direct_release.sh"],"evidence":["Developer ID team","hardened runtime","stapled app and DMG tickets","Gatekeeper assessment","signed Sparkle appcast","artifact SHA-256 manifest"],"strictness":"strict","command":["bash","script/package_direct_release.sh","--validate"]},
    {"id":"ui-runtime","title":"Packaged UI artifact","source":["script/build_and_run.sh","Sources/PersonalSitePublisherMac"],"evidence":["dist/PersonalSitePublisherMac.app"],"strictness":"always","verificationKind":"package","command":["bash","script/check_ui_runtime.sh","--package-only"]},
    {"id":"ui-launch-verification","title":"Real app launch verification","source":["script/build_and_run.sh","dist/PersonalSitePublisherMac.app"],"evidence":["visible main window","launch baseline"],"strictness":"strict","verificationKind":"runtime","command":["bash","script/check_ui_runtime.sh","--launch"]},
    {"id":"accessibility-runtime","title":"Runtime accessibility identifiers","source":["UITests/WorkspaceAccessibilityUITests","dist/PersonalSitePublisherMac.app"],"evidence":["unique runtime AX identifiers across writing, library, images, and repository stages"],"strictness":"strict","verificationKind":"runtime","command":["bash","script/check_accessibility_runtime.sh"]},
    {"id":"privacy-copy","title":"Website distribution privacy and support copy","groups":["quick"],"source":["docs/privacy-support-copy.md","docs/app-store/public-pages/privacy-zh-Hans.html","docs/app-store/public-pages/privacy-en.html","docs/app-store/public-pages/support-zh-Hans.html","docs/app-store/public-pages/support-en.html"],"evidence":["free website distribution boundary","BYOK endpoint consent","browser loopback disclosure","Sparkle update logging disclosure"],"strictness":"always","command":["bash","script/check_privacy_support_copy.sh"]},
    {"id":"privacy-copy-tests","title":"Website privacy copy behavior tests","source":["script/check_privacy_support_copy.sh","script/test_privacy_support_copy.sh"],"evidence":["required direct-distribution disclosures","legacy commercial wording rejection","redaction regressions"],"strictness":"always","command":["bash","script/test_privacy_support_copy.sh"]},
    {"id":"ci-quality","title":"GitHub Actions quality workflow","source":[".github/workflows/quality.yml"],"evidence":["push and pull request quick gate"],"strictness":"always","command":["bash","script/check_ci_quality_workflow.sh"]},
    {"id":"release-runner-contract-tests","title":"Incremental release evidence contract behavior","source":["script/release_gate_runner.py","script/release_gate_result.schema.json"],"evidence":["atomic partial results","per-check timeout","version/build/source/artifact/signature/time binding"],"strictness":"always","command":["python3","script/test_release_gate_runner_contract.py"]},
    {"id":"swift-format-lint","title":"Swift format lint progressive baseline","groups":["quick"],"source":["Package.swift","Sources","Tests","script/quality_baselines.json"],"evidence":["real Xcode swift-format lint","no warning-count regression","classified missing-tool failure"],"strictness":"always","command":["bash","script/check_swift_format.sh"]},
    {"id":"swift-format-lint-tests","title":"Swift format lint gate behavior","groups":["quick"],"source":["script/check_swift_format.sh","script/quality_baselines.json"],"evidence":["baseline and tool-unavailable regressions"],"strictness":"always","command":["bash","script/test_swift_format_gate.sh"]},
    {"id":"swift-safety","title":"Reviewed Swift force-operation and Sendable exceptions","groups":["quick"],"source":["Sources","Tests","script/swift_safety_exceptions.json"],"evidence":["29 production @unchecked Sendable rationales","no new try! or as! without rationale"],"strictness":"always","command":["python3","script/check_swift_safety.py"]},
    {"id":"swift-safety-tests","title":"Swift safety exception gate behavior","groups":["quick"],"source":["script/check_swift_safety.py","script/swift_safety_exceptions.json"],"evidence":["multiline declaration, comment/string, force-operation, and stale-exception regressions"],"strictness":"always","command":["python3","script/test_swift_safety_gate.py"]},
    {"id":"swift-coverage","title":"Swift Sources line coverage progressive baseline","source":["Sources","Tests","script/quality_baselines.json"],"evidence":["SwiftPM code coverage JSON","Sources-only positive line baseline"],"strictness":"standard","timeoutSeconds":2400,"command":["python3","script/check_swift_coverage.py","--result-json",".build/swift-coverage-result.json"]},
    {"id":"swift-coverage-tests","title":"Swift coverage gate behavior","source":["script/check_swift_coverage.py","script/quality_baselines.json"],"evidence":["Sources-only aggregation and baseline regression"],"strictness":"always","command":["python3","script/test_swift_coverage_gate.py"]},
    {"id":"swift-strict-build","title":"Swift 5 complete-concurrency build","groups":["quick"],"source":["Package.swift","Sources"],"evidence":["explicit Swift 5 language mode","complete concurrency checking","warnings as errors"],"strictness":"always","command":["bash","script/check_swift_strict_build.sh"]},
    {"id":"swift-strict-build-tests","title":"Swift 5 complete-concurrency gate behavior","source":["script/check_swift_strict_build.sh"],"evidence":["Swift 5 language-mode and complete-concurrency flag regression"],"strictness":"always","command":["bash","script/test_swift_strict_build_gate.sh"]},
    {"id":"swift6-migration-tests","title":"True Swift 6 migration diagnostic behavior","source":["script/check_swift6_migration.sh"],"evidence":["explicit -swift-version 6 regression"],"strictness":"always","command":["bash","script/test_swift6_migration_gate.sh"]},
    {"id":"swift-release-build","title":"Swift Release configuration build","source":["Package.swift","Sources"],"evidence":["swift build -c release --disable-sandbox"],"strictness":"always","command":["bash","script/check_swift_release_build.sh"]},
    {"id":"swift-release-build-tests","title":"Swift Release build gate behavior","source":["script/check_swift_release_build.sh","script/build_and_run.sh"],"evidence":["Release flags and failure propagation","single application product boundary","App Store, Developer ID, and Chrome release-profile separation"],"strictness":"always","command":["bash","script/test_swift_release_build_gate.sh"]},
    {"id":"swift-tests-sharding-tests","title":"Swift test sharding runner behavior","groups":["quick"],"source":["Package.swift","script/quality_baselines.json","script/run_swift_tests.sh","script/run_swift_test_process.py","script/test_run_swift_tests.py"],"evidence":["closed test-target allowlist and progressive inventory minimums","deterministic exact filters with no missing or duplicate tests","timeout sampling, process-group cleanup, count matching, and fail-fast result preservation"],"strictness":"always","command":["python3","script/test_run_swift_tests.py"]},
    {"id":"swift-tests","title":"Swift behavior test suite","groups":["quick"],"source":["Package.swift","Tests","script/quality_baselines.json","script/run_swift_tests.sh","script/run_swift_test_process.py"],"evidence":["one complete SwiftPM inventory and build artifact","short isolated test processes covering every listed test exactly once","per-shard logs, executed-count checks, timeout samples, and incremental JSON result"],"strictness":"always","timeoutSeconds":900,"command":["bash","script/run_swift_tests.sh"]},
    {"id":"repository-release-clean","title":"Clean committed release checkout","source":["Git worktree"],"evidence":["clean commit-bound release input"],"strictness":"strict","command":["bash","script/check_repository_source_boundary.sh","--release"]}
  ]
}
