    {"id":"swift-strict-build","title":"Package Swift 6 language modes with complete-concurrency build","groups":["quick"],"source":["Package.swift","Sources","Tests"],"evidence":["manifest-declared Swift 6 language modes","native SwiftPM --build-tests compilation of production and test targets","complete concurrency checking","warnings as errors"],"strictness":"always","command":["bash","script/check_swift_strict_build.sh"]},
